{
  "name": "esp-pc-util",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:electron": "npm run build-electron:dev && concurrently --names VITE,ELECTRON -c bgMagenta,bgCyan \"vite --config vite-renderer.config.ts\" \"electron dist/main/main.js\" --kill-others",
    "dev:renderer": "vite --config vite-renderer.config.ts",
    "build-electron:dev": "concurrently --names BUILD-MAIN,BUILD-PRELOAD -c bgGreen,bgYellow \"npm run build-main:dev\" \"npm run build-preload:dev\"",
    "build-electron:prod": "concurrently --names BUILD-RENDERER,BUILD-MAIN,BUILD-PRELOAD -c bgMagenta,bgGreen,bgYellow \"npm run build-renderer:prod\" \"npm run build-main:dev\" \"npm run build-preload:dev\" && tsx build.ts",
    "build-renderer:prod": "tsc -b && vite build --config vite-renderer.config.ts",
    "build-main:dev": "vite build --config vite-main.config.ts",
    "build-main:prod": "tsc -b && vite build --config vite-main.config.ts",
    "build-preload:dev": "vite build --config vite-preload.config.ts",
    "build-preload:prod": "tsc -b && vite build --config vite-preload.config.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-router-devtools": "^1.167.1",
    "concurrently": "^10.0.4",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "serialport": "^13.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/router-plugin": "^1.168.29",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
